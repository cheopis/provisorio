FROM ros:noetic-ros-core

RUN mkdir -p ~/catkin_ws/src/line_detection
RUN mkdir -p ~/catkin_ws/src/realsense-ros-d405

WORKDIR /catkin_ws

COPY . /catkin_ws/src/line_detection
COPY ../../realsense-ros-d405 /catkin_ws/src/

RUN apt-get update && apt-get install -y python3-pip && python3 -m pip install scipy 

RUN apt-get install librealsense2-dkms librealsense2-utils librealsense2-dev ros-noetic-realsense2-camera ros-noetic-realsense2-description

RUN apt remove ros-noetic-realsense2-camera* \
    && apt purge ros-noetic-realsense2-camera*

RUN apt-get update && apt-get install -y \
    python3-colcon-common-extensions \
    build-essential \
    && rm -rf /var/lib/apt/lists/* 

SHELL ["/bin/bash", "-c"]
RUN source /opt/ros/noetic/setup.bash && catkin_make

RUN echo "source /catkin_ws/devel/setup.bash" >> ~/.bashrc

# WORKDIR /catkin_ws/src/gap_detection

CMD ["bash"]